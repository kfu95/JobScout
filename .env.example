# Local-only credentials. Change the password before starting Docker.
POSTGRES_PASSWORD=localdev_only_change_me
# Optional: without a key, deterministic scoring and fact-only packet drafts are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Turn on only after configuring a key; incurs per-job API costs.
ENABLE_AI_SCORING=false
# Turn on only to send ambiguous Gmail metadata to OpenAI for classification.
GMAIL_AI_CLASSIFY=false
POLL_SECONDS=7200
GMAIL_QUERY=
GMAIL_LABELS=

# Free USAJOBS API credentials (email used when requesting the key).
USAJOBS_API_KEY=
USAJOBS_EMAIL=
